{
	"schemaVersion": 1,
	"id": "expomod",
	"version": "${version}",
	"name": "Realistic Explosions Mod",
	"description": "Adds a realistic explosion system to Minecraft with completely overhauled default explosions and new explosives.",
	"authors": [
		"Expomod Team"
	],
	"contact": {
		"homepage": "https://github.com/expomod",
		"sources": "https://github.com/expomod/realistic-explosions"
	},
	"license": "MIT",
	"icon": "assets/expomod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.expomod.Expomod"
		],
		"client": [
			"com.expomod.client.ExpomodClient"
		],
		"fabric-datagen": [
			"com.expomod.client.ExpomodDataGenerator"
		]
	},
	"mixins": [
		"expomod.mixins.json",
		{
			"config": "expomod.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}